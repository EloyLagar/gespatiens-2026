# Copia este fichero como .env para cambiar los valores de docker-compose.yml. El .env no se sube al repositorio

# Contraseña de PostgreSQL dentro de Docker
DB_PASSWORD=gespatiens-demo
# Firma las sesiones: al menos 32 caracteres. Cámbialo si la app va a estar en internet
JWT_SECRET=solo-para-la-demo-local-cambiar-antes-de-publicar
# demo: datos de demostración. Déjalo vacío para empezar con una base de datos limpia (necesita ADMIN_*)
PROFILE=demo
# El administrador inicial, para la base de datos limpia
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
# Puerto del equipo en el que se abre la app
PORT=8080
